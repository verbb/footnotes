{
  "name": "@verbb/ckeditor5-footnotes",
  "version": "0.0.1",
  "description": "A plugin for CKEditor 5.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./dist/index.js": "./dist/index.js",
    "./*": "./dist/*",
    "./browser/*": null,
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "dist",
    "lang",
    "src",
    "theme",
    "ckeditor5-metadata.json"
  ],
  "devDependencies": {
    "@ckeditor/ckeditor5-dev-build-tools": "43.0.1",
    "@ckeditor/ckeditor5-inspector": ">=4.1.0",
    "@ckeditor/ckeditor5-package-tools": "^4.1.1",
    "ckeditor5": "^47.5.0",
    "http-server": "^14.1.0",
    "webdriverio": "^9.0.7"
  },
  "peerDependencies": {
    "ckeditor5": "^47.5.0 || ^0.0.0-nightly"
  },
  "scripts": {
    "build": "node ./scripts/build-dist.mjs",
    "dev": "ckeditor5-package-tools start"
  }
}
