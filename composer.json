{
    "name": "verbb/footnotes",
    "description": "A Craft CMS plugin for adding linked footnotes to CKEditor fields and Twig templates.",
    "type": "craft-plugin",
    "version": "6.0.6",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "redactor",
        "ckeditor",
        "footnotes"
    ],
    "support": {
        "email": "support@verbb.io",
        "issues": "https://github.com/verbb/footnotes/issues?state=open",
        "source": "https://github.com/verbb/footnotes",
        "docs": "https://github.com/verbb/footnotes",
        "rss": "https://github.com/verbb/footnotes/commits/v2.atom"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Verbb",
            "homepage": "https://verbb.io"
        },
        {
            "name": "Vierbeuter",
            "homepage": "https://www.vierbeuter.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0",
        "craftcms/ckeditor": "^5.0.0",
        "verbb/base": "^3.0.19"
    },
    "autoload": {
        "psr-4": {
            "verbb\\footnotes\\": "src/"
        }
    },
    "extra": {
        "name": "Footnotes",
        "handle": "footnotes",
        "changelogUrl": "https://raw.githubusercontent.com/verbb/footnotes/craft-5/CHANGELOG.md",
        "class": "verbb\\footnotes\\Footnotes"
    }
}
